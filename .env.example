AUTH_SECRET="your-auth-secret-here"
DATABASE_URL="postgresql://user:password@localhost:5432/dbname"
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL_PRIMARY="gemini-2.0-flash"
GEMINI_MODEL_FALLBACK="gemini-2.0-flash-lite"

# Optional Free AI Backup Providers (automatically used if Gemini is under high demand / 503)
GROQ_API_KEY="" # Free API key from https://console.groq.com (Ultra-fast LLaMA 3.3 70B)
OPENROUTER_API_KEY="" # Optional Free tier key from https://openrouter.ai

UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# SSE Relay Configuration (Optional, fallback is polling)
NEXT_PUBLIC_RELAY_URL="http://localhost:4000"
RELAY_INGEST_URL="http://localhost:4000/ingest"
INGEST_SECRET="generate_a_strong_secret_key_here"

# Vercel Cron Jobs (Required for daily quiz generation & evaluation)
CRON_SECRET="generate_a_strong_secret_key_here"
